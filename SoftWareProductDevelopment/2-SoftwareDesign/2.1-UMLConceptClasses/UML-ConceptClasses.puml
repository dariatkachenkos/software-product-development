@startuml

hide circle
title UML-діаграма концептуальних класів — CreativeFlow

class ТворчаЛюдина {
    ім'я
    email
    тип_творчості
    дата_реєстрації
}

class ТворчаСесія {
    дата_сесії
    тривалість_хв
    тип_творчості
    назва
    рейтинг_якості
    енергія_до
}

class ЩоденнийЖурнал {
    дата_запису
    годин_сну
    рівень_енергії
    настрій
    рівень_стресу
}

class ЗаписХарчування {
    назва_страви
    калорії
    час_прийому
}

class Інсайт {
    тип_інсайту
    опис
    коефіцієнт_кореляції
    дата_генерації
}

class Рекомендація {
    категорія
    текст
    на_основі_днів
    дата_створення
}

ТворчаЛюдина "1" --> "+" ТворчаСесія : проводить
ТворчаЛюдина "1" --> "+" ЩоденнийЖурнал : веде
ЩоденнийЖурнал "1" --> "+" ЗаписХарчування : містить
ТворчаЛюдина "1" --> "+" Інсайт : отримує
ТворчаЛюдина "1" --> "+" Рекомендація : отримує

@enduml
