@startuml

hide circle
title UML-діаграма концептуальних класів — MusicHealth

class Музикант {
    ім'я
    прізвище
    email
    дата_народження
    вага
    зріст
}

class РаціонДня {
    дата
}

class ПродуктХарчування {
    назва
    калорії_на_100г
    білки_на_100г
    жири_на_100г
    вуглеводи_на_100г
}

class ЗаписПродукту {
    кількість_г
    час_додавання
}

class ФізичнийПоказник {
    тип_показника
    значення
    дата_виміру
}

class Рекомендація {
    текст
    дата_генерації
    тип_нутрієнту
}

Музикант "1" --> "+" РаціонДня : веде
РаціонДня "1" --> "+" ЗаписПродукту : містить
ЗаписПродукту "+" --> "1" ПродуктХарчування : посилається
Музикант "1" --> "+" ФізичнийПоказник : фіксує
Музикант "1" --> "+" Рекомендація : отримує

@enduml
