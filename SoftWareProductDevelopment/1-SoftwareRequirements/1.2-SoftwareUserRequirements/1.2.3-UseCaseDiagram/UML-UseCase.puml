@startuml

title Діаграма прецедентів — CreativeFlow

left to right direction

actor "Творча людина" as User
actor "Система\nсповіщень" as NotifSystem

rectangle CreativeFlow {
    usecase "UC1: Записати\nтворчу сесію" as UC1
    usecase "UC2: Записати\nстан дня" as UC2
    usecase "UC3: Переглянути\nаналітику" as UC3
    usecase "UC4: Отримати\nрекомендації" as UC4
    usecase "UC5: Встановити\nнагадування" as UC5
    usecase "UC6: Налаштувати\nпрофіль" as UC6
    usecase "UC7: Записати\nхарчування" as UC7
    usecase "UC8: Обчислити\nденний підсумок" as UC8
}

User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5
User --> UC6

UC2 ..> UC7 : include
UC2 ..> UC8 : include
UC3 ..> UC8 : include

UC5 ..> UC1 : extend
NotifSystem --> UC8

@enduml
